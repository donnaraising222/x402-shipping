                },
                "example": {
                  "source": "fixture",
                  "testMode": true,
                  "quotedAt": "2026-08-07T12:00:00.000Z",
                  "shipmentId": "shp_fixture_cf65f479a7323d17",
                  "shipment": {
                    "from": {
                      "city": "San Francisco",
                      "state": "CA",
                      "zip": "94117",
                      "country": "US"
                    },
                    "to": {
                      "city": "Washington",
                      "state": "DC",
                      "zip": "20500",
                      "country": "US"
                    },
                    "parcel": {
                      "pounds": 2,
                      "cubicFeet": 0.19,
                      "zone": 8
                    }
                  },
                  "rateCount": 7,
                  "cheapest": {
                    "rateId": "rate_fixture_01_usps_ground_advantage",
                    "carrier": "USPS",
