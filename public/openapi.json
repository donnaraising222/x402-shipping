{
  "openapi": "3.1.0",
  "info": {
    "title": "x402-shipping",
    "version": "0.1.0",
    "description": "Rate shopping and label generation via Shippo/EasyPost test mode — agents ship things, label returned in-response\n\nEvery paid route returns the purchased artifact in the 200 response body. Pay in USDC on Base or Solana — your client picks the rail.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": {
      "name": "nirholas",
      "email": "nichxbt@gmail.com",
      "url": "https://github.com/nirholas/x402-shipping"
    },
    "x-guidance": "Rate shopping and label generation via Shippo/EasyPost test mode — agents ship things, label returned in-response. Every paid route answers an unpaid request with HTTP 402 and a list of accepted payments (USDC on Base or Solana — pick either), then returns the purchased artifact in the body of the same request once you retry with an X-PAYMENT header. Payment and delivery happen in one round trip; nothing is promised for later. POST /rates ($0.003) returns carrier rate table POST /label ($0.02) returns label PDF (base64) + tracking number"
  },
  "servers": [
    {
      "url": "http://localhost:4023",
      "description": "Local development"
    },
    {
      "url": "https://your-deployment.example.com",
      "description": "Your deployment"
    }
  ],
  "tags": [
    {
      "name": "paid",
      "description": "x402-paid routes. An unpaid request answers 402 with both rails."
    },
    {
      "name": "free",
      "description": "Free routes. No payment required."
    }
  ],
  "paths": {
    "/rates": {
      "post": {
        "operationId": "quoteRates",
        "summary": "Rate-shop a parcel across every available carrier service.",
        "description": "Prices a shipment across every carrier service available for the route. Each rate carries a `rateId` you pass to `POST /label`, the carrier and service name, the price and currency, estimated transit days, and the carrier's own duration terms. The response also surfaces `cheapest` and `fastest` directly so a caller doesn't have to sort. Dimensions accept `in` or `cm` and weight accepts `oz`, `lb`, `g` or `kg` — conversion happens server-side.\n\nPrice: **$0.003** in USDC — payable on Base (EVM) or Solana.",
        "tags": [
          "paid"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "street1": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "zip": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      }
                    }
                  },
                  "to": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "street1": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "zip": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      }
                    }
                  },
                  "parcel": {
                    "type": "object",
                    "properties": {
                      "length": {
                        "type": "integer"
                      },
                      "width": {
                        "type": "integer"
                      },
                      "height": {
                        "type": "integer"
                      },
                      "weight": {
                        "type": "integer"
                      },
                      "distanceUnit": {
                        "type": "string"
                      },
                      "massUnit": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "example": {
                "from": {
                  "name": "Acme Robotics",
                  "street1": "215 Clayton St",
                  "city": "San Francisco",
                  "state": "CA",
                  "zip": "94117",
                  "country": "US"
                },
                "to": {
                  "name": "Dana Reyes",
                  "street1": "1600 Pennsylvania Ave NW",
                  "city": "Washington",
                  "state": "DC",
                  "zip": "20500",
                  "country": "US"
                },
                "parcel": {
                  "length": 10,
                  "width": 8,
                  "height": 4,
                  "weight": 32,
                  "distanceUnit": "in",
                  "massUnit": "oz"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the full carrier rate table with prices, transit days, and `cheapest` / `fastest` flags",
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 JSON settlement receipt (rail, network, transaction, payer).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
